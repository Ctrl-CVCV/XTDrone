<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- Single intruder UAV (iris_red) as iris_0: PX4 SITL + gazebo spawn + MAVROS.
         Must be spawned as iris_0 so get_local_pose.py iris 1 resolves
         msg.name.index('iris_0').  Gazebo empty world is started separately. -->
    <arg name="mavlink_udp_port" default="14560"/>
    <arg name="mavlink_tcp_port" default="4560"/>

    <group ns="iris_0">
        <include file="$(find px4)/launch/single_vehicle_spawn_xtd.launch">
            <arg name="vehicle" value="iris"/>
            <arg name="sdf" value="iris_red"/>
            <arg name="ID" value="0"/>
            <arg name="ID_in_group" value="0"/>
            <arg name="x" value="0"/>
            <arg name="y" value="0"/>
            <arg name="z" value="0"/>
            <arg name="Y" value="0"/>
            <arg name="mavlink_udp_port" value="$(arg mavlink_udp_port)"/>
            <arg name="mavlink_tcp_port" value="$(arg mavlink_tcp_port)"/>
        </include>
        <include file="$(find mavros)/launch/px4.launch">
            <arg name="fcu_url" value="udp://:14540@127.0.0.1:14580"/>
            <arg name="gcs_url" value=""/>
            <arg name="tgt_system" value="1"/>
            <arg name="tgt_component" value="1"/>
        </include>
    </group>
</launch>
