<?xml version='1.0'?>
<sdf version='1.7'>
  <!-- Invisible viewpoint camera.  Camera spec mirrors the sim gimbal camera
       (basic_room_sim/models/camera_gimbal/model.sdf): 640x480 R8G8B8,
       horizontal_fov 1.0472, clip 0.01..100, update_rate 30,
       libgazebo_ros_camera.so.  Structure follows the proven
       tmp_meshtest/down_cam.sdf (robotNamespace + always_on are required for
       the plugin to advertise).  No <visual>/<collision> -> invisible.
       @{MODEL_NAME} is substituted by capture_views.py. -->
  <model name='@{MODEL_NAME}'>
    <static>1</static>
    <link name='link'>
      <sensor name='view_camera' type='camera'>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.01</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <plugin name='cam_ros' filename='libgazebo_ros_camera.so'>
          <robotNamespace>/@{MODEL_NAME}</robotNamespace>
          <imageTopicName>image_raw</imageTopicName>
          <cameraName>cam</cameraName>
          <alwaysOn>true</alwaysOn>
          <updateRate>30</updateRate>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
          <distortionT3>0.0</distortionT3>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
