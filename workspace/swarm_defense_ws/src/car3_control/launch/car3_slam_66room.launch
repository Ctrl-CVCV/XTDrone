<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- 6_6_room manual mapping: Gazebo + car3 + gmapping + keyboard teleop + rviz.
         Drive with w/a/s/d (forward/strafe) and q/e (rotate) IN THIS TERMINAL.
         +/- adjust linear speed, ]/[ angular, space = stop.
         Save the map from another terminal:
           rosrun map_server map_saver -f /workspace/swarm_defense_ws/src/car3_control/maps/6_6_room -->
    <arg name="gui" default="true"/>
    <arg name="keyboard" default="true"/>
    <arg name="rviz" default="true"/>

    <!-- sim + ros_control + odom + lidar (spawn at room center = world origin) -->
    <include file="$(find car3_control)/launch/car3_bringup.launch">
        <arg name="gui" value="$(arg gui)"/>
        <arg name="world_launch" value="6_6_room"/>
        <arg name="x" value="0"/>
        <arg name="y" value="0"/>
    </include>

    <!-- gmapping: room interior is x -2.85..2.85, y -2.85..2.85 (walls at ±2.925) -->
    <node name="slam_gmapping" pkg="gmapping" type="slam_gmapping">
        <param name="base_frame" value="base_footprint"/>
        <param name="odom_frame" value="odom"/>
        <param name="map_frame" value="map"/>
        <param name="map_update_interval" value="1.0"/>
        <param name="maxUrange" value="20.0"/>
        <param name="maxRange" value="20.0"/>
        <param name="sigma" value="0.05"/>
        <param name="kernelSize" value="1"/>
        <param name="lstep" value="0.05"/>
        <param name="astep" value="0.05"/>
        <param name="iterations" value="5"/>
        <param name="lsigma" value="0.075"/>
        <param name="ogain" value="3.0"/>
        <param name="lskip" value="0"/>
        <param name="minimumScore" value="50"/>
        <param name="srr" value="0.1"/>
        <param name="srt" value="0.2"/>
        <param name="str" value="0.1"/>
        <param name="stt" value="0.2"/>
        <param name="linearUpdate" value="0.2"/>
        <param name="angularUpdate" value="0.2"/>
        <param name="temporalUpdate" value="-1.0"/>
        <param name="resampleThreshold" value="0.5"/>
        <param name="particles" value="30"/>
        <param name="xmin" value="-3.5"/>
        <param name="ymin" value="-3.5"/>
        <param name="xmax" value="3.5"/>
        <param name="ymax" value="3.5"/>
        <param name="delta" value="0.05"/>
        <param name="llsamplerange" value="0.01"/>
        <param name="llsamplestep" value="0.01"/>
        <param name="lasamplerange" value="0.005"/>
        <param name="lasamplestep" value="0.005"/>
    </node>

    <!-- manual keyboard drive (mecanum: w/s fwd-back, a/d strafe, q/e rotate);
         needs a terminal, so it is optional for headless runs -->
    <node name="car3_keyboard_control" pkg="car3_control" type="car3_keyboard_control.py"
          output="screen" required="true" if="$(arg keyboard)"/>

    <!-- live map view -->
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find car3_control)/rviz/car3_slam.rviz" if="$(arg rviz)"/>
</launch>
