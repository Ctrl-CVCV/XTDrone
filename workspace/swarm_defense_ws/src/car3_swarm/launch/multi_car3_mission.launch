<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- 一体化任务（巡检—入侵—区域封控—协同围捕）launch。
         Phase 1 骨架：世界 + 三车 + 全局共享真值 + mission 参数 +
         car2（入侵车）导航链（AMCL + 虚拟障碍 + nav_to_pose）+ intruder_node。
         后续 Phase 追加：car0/car1 扩展巡检/围捕节点 + mission_manager。 -->
    <arg name="gui" default="true"/>
    <arg name="patrol_speed" default="0.35"/>  <!-- Test 3 可临时调慢 -->
    <!-- 可选覆盖：单门固定入侵（mission_demo_{up,down,left,right}.sh 使用）。
         默认为空 = 沿用 mission_params.yaml（entry_mode: random 每轮随机换门），
         不传参时行为与既有 mission_demo.sh 完全一致。 -->
    <arg name="entry_mode" default=""/>
    <arg name="entry_gate" default=""/>
    <arg name="car0_x" default="2.3"/>
    <arg name="car0_y" default="2.4"/>
    <arg name="car0_yaw" default="-2.334"/>
    <arg name="car1_x" default="-2.3"/>
    <arg name="car1_y" default="-2.4"/>
    <arg name="car1_yaw" default="0.808"/>
    <!-- 入侵车出生在西北走廊（外墙内、内墙外） -->
    <arg name="car2_x" default="-6.5"/>
    <arg name="car2_y" default="6.6"/>
    <arg name="car2_yaw" default="0.0"/>

    <include file="$(find basic_room_sim)/launch/nesting_room.launch">
        <arg name="gui" value="$(arg gui)"/>
    </include>

    <include file="$(find car3_swarm)/launch/car_spawn.launch">
        <arg name="car" value="car0"/>
        <arg name="x" value="$(arg car0_x)"/>
        <arg name="y" value="$(arg car0_y)"/>
        <arg name="yaw" value="$(arg car0_yaw)"/>
    </include>

    <include file="$(find car3_swarm)/launch/car_spawn.launch">
        <arg name="car" value="car1"/>
        <arg name="x" value="$(arg car1_x)"/>
        <arg name="y" value="$(arg car1_y)"/>
        <arg name="yaw" value="$(arg car1_yaw)"/>
    </include>

    <include file="$(find car3_swarm)/launch/car_spawn.launch">
        <arg name="car" value="car2"/>
        <arg name="x" value="$(arg car2_x)"/>
        <arg name="y" value="$(arg car2_y)"/>
        <arg name="yaw" value="$(arg car2_yaw)"/>
    </include>

    <!-- one map for all cars (map frame == world frame) -->
    <node name="map_server" pkg="map_server" type="map_server"
          args="$(find car3_control)/maps/nesting_room.yaml"/>

    <!-- global shared ground-truth state (all three cars) -->
    <node name="car_state_broadcaster" pkg="car3_swarm" type="car_state_broadcaster"
          output="screen">
        <rosparam param="cars">[car0, car1, car2]</rosparam>
        <param name="rate" value="20.0"/>
    </node>

    <!-- mission parameters (single source of truth, read via /mission/...) -->
    <rosparam ns="mission" file="$(find car3_swarm)/config/mission_params.yaml"
              command="load"/>
    <!-- 复位回归点 = car2 出生位姿（与上方 car2_x/car2_y 同源，覆盖 YAML 默认） -->
    <group ns="mission">
        <param name="intruder/spawn_pose" type="yaml"
               value="[$(arg car2_x), $(arg car2_y)]"/>
    </group>
    <!-- 可选覆盖 YAML 的入口模式/入口门（仅当参数非空时加载） -->
    <group ns="mission" if="$(eval entry_mode != '')">
        <param name="intruder/entry_mode" value="$(arg entry_mode)"/>
    </group>
    <group ns="mission" if="$(eval entry_gate != '')">
        <param name="intruder/entry_gate" value="$(arg entry_gate)"/>
    </group>

    <!-- task-level state machine: intrusion detection, roles, PL/PR,
         capture/escape judgment (never commands chassis motion) -->
    <node name="mission_manager" pkg="car3_swarm" type="mission_manager.py"
          output="screen"/>

    <!-- car0: Car B (NE). Patrol watches 下门 first, then 左门 (SDF-true
         gate centers). Patrol FSM unchanged; /mission/state interrupt added. -->
    <group ns="car0">
        <node name="patrol" pkg="car3_swarm" type="patrol_node.py" output="screen">
            <param name="forward_distance" value="2.0"/>
            <param name="patrol_speed" value="$(arg patrol_speed)"/>
            <param name="max_omega" value="0.50"/>
            <param name="angle_tolerance" value="0.052"/>
            <param name="dwell_time" value="0.4"/>
            <param name="hold_yaw_gain" value="2.0"/>
            <param name="rate" value="20.0"/>
            <rosparam param="doors">[[-0.116, -3.059], [-3.166, -0.009]]</rosparam>
        </node>
        <!-- collision boxes mirror /mission/collision in mission_params.yaml:
             friendly for the other defender, smaller target_safe for car2 -->
        <node name="virtual_obstacle" pkg="car3_swarm" type="virtual_obstacle_node"
              output="screen">
            <rosparam param="other_cars">[car1, car2]</rosparam>
            <param name="box_x" value="0.45"/>
            <param name="box_y" value="0.38"/>
            <param name="target_box_x" value="0.34"/>
            <param name="target_box_y" value="0.30"/>
            <param name="intruder_name" value="car2"/>
        </node>
    </group>

    <!-- car1: Car A (SW). Patrol watches 上门 first, then 右门 (SDF-true
         gate centers). -->
    <group ns="car1">
        <node name="patrol" pkg="car3_swarm" type="patrol_node.py" output="screen">
            <param name="forward_distance" value="2.0"/>
            <param name="patrol_speed" value="$(arg patrol_speed)"/>
            <param name="max_omega" value="0.50"/>
            <param name="angle_tolerance" value="0.052"/>
            <param name="dwell_time" value="0.4"/>
            <param name="hold_yaw_gain" value="2.0"/>
            <param name="rate" value="20.0"/>
            <rosparam param="doors">[[-0.116, 3.041], [2.934, -0.009]]</rosparam>
        </node>
        <node name="virtual_obstacle" pkg="car3_swarm" type="virtual_obstacle_node"
              output="screen">
            <rosparam param="other_cars">[car0, car2]</rosparam>
            <param name="box_x" value="0.45"/>
            <param name="box_y" value="0.38"/>
            <param name="target_box_x" value="0.34"/>
            <param name="target_box_y" value="0.30"/>
            <param name="intruder_name" value="car2"/>
        </node>
    </group>

    <!-- car2: intruder (Car E), NW outer corridor. Navigation chain for the
         approach phase + the intruder mission state machine. -->
    <group ns="car2">
        <node name="amcl" pkg="amcl" type="amcl" output="screen"
              launch-prefix="bash -c 'timeout 90 rostopic echo -n1 /car2/scan &gt;/dev/null 2&gt;&amp;1 || true; exec $0 $@'">
            <remap from="static_map" to="/static_map"/>
            <rosparam file="$(find car3_control)/params/amcl_params.yaml" command="load"/>
            <param name="odom_frame_id" value="car2/odom"/>
            <param name="base_frame_id" value="car2/base_footprint"/>
            <param name="initial_pose_x" value="$(arg car2_x)"/>
            <param name="initial_pose_y" value="$(arg car2_y)"/>
            <param name="initial_pose_a" value="$(arg car2_yaw)"/>
        </node>
        <node name="virtual_obstacle" pkg="car3_swarm" type="virtual_obstacle_node"
              output="screen"
              launch-prefix="bash -c 'timeout 90 rostopic echo -n1 /car2/scan &gt;/dev/null 2&gt;&amp;1 || true; exec $0 $@'">
            <rosparam param="other_cars">[car0, car1]</rosparam>
            <param name="box_x" value="0.45"/>
            <param name="box_y" value="0.38"/>
            <param name="target_box_x" value="0.34"/>
            <param name="target_box_y" value="0.30"/>
            <param name="intruder_name" value="car2"/>
        </node>
        <node name="nav_to_pose" pkg="car3_control" type="nav_to_pose_node"
              output="screen"
              launch-prefix="bash -c 'timeout 90 rostopic echo -n1 /car2/scan &gt;/dev/null 2&gt;&amp;1 || true; exec $0 $@'">
            <rosparam file="$(find car3_control)/params/nav_to_pose_params.yaml"
                      command="load"/>
            <param name="scan_topic" value="scan_filtered"/>
        </node>
        <node name="intruder" pkg="car3_swarm" type="intruder_node.py" output="screen"/>
    </group>
</launch>
