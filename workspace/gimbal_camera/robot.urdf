<?xml version='1.0' encoding='utf-8'?>
<!-- 云台相机（CAD 导出）集成版 URDF
     改动相对原始 camera_urdf/robot.urdf：
     1. mesh 路径改为绝对路径（file:///workspace/gimbal_camera/meshes/），Gazebo 任意 CWD 均可加载
     2. 为 link_YAW_joint / link_ROLL_joint 添加 PositionJointInterface transmission
     3. 添加 gazebo_ros_control 插件（robotNamespace=/gimbal），由 ROS 话题控制云台
     相机传感器与 libgazebo_ros_camera 插件保持原样：话题 /gimbal_camera/image_raw -->
<robot name="gimbal_camera">
  <link name="base_link">
    <inertial>
      <origin xyz="0.00013909892 0.00013685687 -0.0015628412" rpy="0 0 0" />
      <mass value="0.079097845" />
      <inertia ixx="2.6851797e-05" iyy="3.1551232e-05" izz="4.7326611e-05" ixy="-2.0570896e-08" ixz="-5.749476e-08" iyz="-9.8053429e-08" />
    </inertial>
    <visual>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_004_solid_004.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_007_solid_007.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_003_solid_003.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_006_solid_006.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_005_solid_005.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_002_solid_002.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_001_solid_001.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_004_solid_004.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_007_solid_007.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_003_solid_003.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_006_solid_006.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_005_solid_005.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_002_solid_002.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.0045947285 0.0051830235 -1.0195" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_001_solid_001.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="link_YAW">
    <inertial>
      <origin xyz="-0.0069977394 -0.014614324 0.013633263" rpy="0 0 0" />
      <mass value="0.023667484" />
      <inertia ixx="1.516529e-05" iyy="1.1481096e-05" izz="7.8066941e-06" ixy="-2.2889e-06" ixz="2.8085623e-06" iyz="5.8654173e-06" />
    </inertial>
    <visual>
      <origin xyz="-0.0048032038 0.0049472985 -1.039" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_008_solid_008.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0048032038 0.0049472985 -1.039" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_008_solid_008.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="link_ROLL">
    <inertial>
      <origin xyz="-6.0988092e-08 2.7535263e-10 -0.012381598" rpy="0 0 0" />
      <mass value="0.013033425" />
      <inertia ixx="1.8374964e-06" iyy="4.9212611e-06" izz="4.0390911e-06" ixy="3.1356037e-07" ixz="-1.0114726e-11" iyz="1.9803367e-13" />
    </inertial>
    <visual>
      <origin xyz="-0.0064687661 -1.089 -0.037934806" rpy="-1.5707963 0.44656282 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_009_solid_009.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0064687661 -1.089 -0.037934806" rpy="-1.5707963 0.44656282 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_009_solid_009.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="link_PITCH">
    <inertial>
      <origin xyz="0.00079794277 -0.00025419143 -0.017500002" rpy="0 0 0" />
      <mass value="0.038839518" />
      <inertia ixx="7.8388505e-06" iyy="6.4743124e-06" izz="6.1440056e-06" ixy="-4.8376547e-07" ixz="-1.114686e-14" iyz="-3.8390454e-12" />
    </inertial>
    <visual>
      <origin xyz="-0.21249174 -1.0631895 0.085123729" rpy="-1.7997729 -1.1138466 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_010_solid_010.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.21249174 -1.0631895 0.085123729" rpy="-1.7997729 -1.1138466 0" />
      <geometry>
        <mesh filename="file:///workspace/gimbal_camera/meshes/part_010_solid_010.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <joint name="link_YAW_joint" type="revolute">
    <origin xyz="0.00020847528 0.00023572496 0.0195" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link_YAW" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5" />
  </joint>
  <joint name="link_ROLL_joint" type="revolute">
    <origin xyz="-0.015351613 -0.032061153 0.05" rpy="1.5707963 0 -0.44656282" />
    <parent link="link_YAW" />
    <child link="link_ROLL" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5" />
  </joint>
  <joint name="link_PITCH_joint" type="fixed">
    <origin xyz="0.017412022 -0.0017525708 -0.02826721" rpy="1.5707963 1.3646162 1.4704812" />
    <parent link="link_ROLL" />
    <child link="link_PITCH" />
  </joint>
  <transmission name="link_YAW_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="link_YAW_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="link_YAW_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="link_ROLL_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="link_ROLL_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="link_ROLL_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </actuator>
  </transmission>
  <gazebo reference="link_PITCH">
    <sensor type="camera" name="gimbal_camera">
      <pose>0 0 0.0175 -1.57 0 0</pose>
      <update_rate>30.0</update_rate>
      <camera name="gimbal_camera">
        <horizontal_fov>1.04719755</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>100</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>30.0</updateRate>
        <cameraName>gimbal_camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>link_PITCH</frameName>
        <hackBaseline>0.07</hackBaseline>
        <distortionK1>0.0</distortionK1>
        <distortionK2>0.0</distortionK2>
        <distortionK3>0.0</distortionK3>
        <distortionT1>0.0</distortionT1>
        <distortionT2>0.0</distortionT2>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/gimbal</robotNamespace>
      <controlPeriod>0.01</controlPeriod>
    </plugin>
  </gazebo>
</robot>
